<?xml version='1.0' encoding='windows-1252'?>
<?if $(sys.BUILDARCH) = x64 or $(sys.BUILDARCH) = arm64 ?>
    <?define PlatformProgramFilesFolder = "ProgramFiles64Folder" ?>
<?else ?>
    <?define PlatformProgramFilesFolder = "ProgramFilesFolder" ?>
<?endif ?>

<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'
     xmlns:firewall='http://schemas.microsoft.com/wix/FirewallExtension'>

    <Product
        Id='*'
        Name='nexrade-cache'
        UpgradeCode='1A129356-5E6D-4B77-BCF9-63A8E46BBDD0'
        Manufacturer='Nexrade'
        Language='1033'
        Codepage='1252'
        Version='$(var.Version)'>

        <Package Id='*'
            Keywords='Installer'
            Description='nexrade-cache — Redis-compatible cache server written in Rust'
            Manufacturer='Nexrade'
            InstallerVersion='500'
            Languages='1033'
            Compressed='yes'
            InstallScope='perMachine'
            SummaryCodepage='1252'/>

        <!-- Silently replace older versions -->
        <MajorUpgrade
            Schedule='afterInstallInitialize'
            DowngradeErrorMessage='A newer version of [ProductName] is already installed. Setup will now exit.'/>

        <Media Id='1' Cabinet='media1.cab' EmbedCab='yes' DiskPrompt='CD-ROM #1'/>
        <Property Id='DiskPrompt' Value='nexrade-cache Installation'/>

        <!-- ── Directory layout ───────────────────────────────────────── -->
        <Directory Id='TARGETDIR' Name='SourceDir'>
            <Directory Id='$(var.PlatformProgramFilesFolder)'>
                <Directory Id='APPLICATIONFOLDER' Name='nexrade-cache'>

                    <Directory Id='Bin' Name='bin'>

                        <!-- Add bin\ to system PATH -->
                        <Component Id='Path' Guid='2F5A15BC-C974-4DCB-A635-926830EA9247' KeyPath='yes'>
                            <Environment
                                Id='PATH'
                                Name='PATH'
                                Value='[Bin]'
                                Permanent='no'
                                Part='last'
                                Action='set'
                                System='yes'/>
                        </Component>

                        <!-- Main server binary -->
                        <Component Id='binary0' Guid='*'>
                            <File Id='exe0'
                                Name='nexrade-cache.exe'
                                DiskId='1'
                                Source='$(var.CargoTargetBinDir)\nexrade-cache.exe'
                                KeyPath='yes'/>
                        </Component>

                        <!-- CLI client binary -->
                        <Component Id='binary1' Guid='*'>
                            <File Id='exe1'
                                Name='nexrade-cli.exe'
                                DiskId='1'
                                Source='$(var.CargoTargetBinDir)\nexrade-cli.exe'
                                KeyPath='yes'/>
                        </Component>

                        <!-- Windows Service (optional) -->
                        <!--
                            The service gets its OWN installed copy of the server
                            binary, under a distinct name. Two constraints force
                            this shape:

                            1. MSI derives a service's image path from the <File>
                               in the SAME component as <ServiceInstall>. With only
                               a RegistryValue keypath the ServiceInstall row has
                               no path, and the install fails with
                               'Service "" (nexrade-cache) could not be configured'
                               — note the empty name, which is MSI reporting a
                               missing binary rather than a permissions problem.
                            2. It must not share a filename with the foreground
                               binary while that one is running: Windows holds an
                               OPEN_EXECUTING_IMAGE lock on a live service image,
                               and an upgrade that tries to overwrite it hangs the
                               file-copy step indefinitely.

                            A separate name satisfies both. The extra ~10MB is the
                            price of an upgradeable service. `install_service`
                            resolves its path via std::env::current_exe(), so the
                            binary is name-agnostic.
                        -->
                        <Component Id='NexradeCacheService' Guid='4B2F8E3D-9A1C-4E7F-B5D6-8C9E2A4F6B1D'>
                            <File Id='ServiceBinary'
                                Name='nexrade-cache-service.exe'
                                DiskId='1'
                                Source='$(var.CargoTargetBinDir)\nexrade-cache.exe'
                                KeyPath='yes'/>
                            <ServiceInstall
                                Id='NexradeCacheServiceInstall'
                                Name='nexrade-cache'
                                DisplayName='Nexrade Cache'
                                Description='High-performance Redis-compatible cache server (nexrade-cache)'
                                Type='ownProcess'
                                Start='auto'
                                ErrorControl='normal'
                                Account='LocalSystem'
                                Arguments='--service --port [INSTALLPORT][MAXMEMORYARG]'>
                                <!-- Delayed auto-start keeps the cache off the
                                     critical boot path, so it does not compete
                                     with other auto-start services during
                                     login. candle emits CNDL1150 here
                                     suggesting WixUtilExtension's ServiceConfig
                                     instead; that element configures failure
                                     actions and has no DelayedAutoStart
                                     attribute, so it cannot express this. The
                                     build passes -sw1150 to suppress it. -->
                                <ServiceConfig
                                    DelayedAutoStart='yes'
                                    OnInstall='yes'
                                    OnReinstall='yes'/>
                            </ServiceInstall>
                            <ServiceControl
                                Id='NexradeCacheServiceControl'
                                Name='nexrade-cache'
                                Start='install'
                                Stop='both'
                                Remove='uninstall'
                                Wait='no'/>
                        </Component>

                    </Directory>

                    <!-- Example config file in the root install dir -->
                    <Component Id='ConfigExample' Guid='*'>
                        <File Id='ConfigExampleFile'
                            Name='nexrade.example.toml'
                            DiskId='1'
                            Source='nexrade.example.toml'
                            KeyPath='yes'/>
                    </Component>

                    <!-- Optional Windows Firewall inbound rule, added only
                             when the operator leaves the dialog checkbox
                             ticked. WiX creates the rule on install and
                             removes it on uninstall automatically. The
                             Port value comes from the [INSTALLPORT]
                             property the operator entered in the dialog,
                             which already defaults to 6379.
                             Guid is explicit (not '*'): this component has no
                             file/registry keypath for light to hash, so an
                             auto-generated guid is rejected with LGHT0230.
                             KeyPath='yes' marks the component itself. -->
                    <Component Id='NexradeCacheFirewall' Guid='37952E97-D87B-5FDC-8CE1-B422BABBF420' Win64='yes' KeyPath='yes'>
                        <Condition><![CDATA[INSTALLFIREWALL]]></Condition>
                        <firewall:FirewallException Id='NexradeCacheFirewallRule'
                                           Name='nexrade-cache'
                                           Port='[INSTALLPORT]'
                                           Protocol='tcp'
                                           Profile='all'
                                           Scope='any'
                                           Description='Inbound TCP for nexrade-cache (Redis-compatible cache)'/>
                    </Component>

                </Directory>
            </Directory>

            <!-- Start Menu shortcuts -->
            <Directory Id='ProgramMenuFolder'>
                <Directory Id='ApplicationProgramsFolder' Name='nexrade-cache'>
                    <Component Id='ApplicationShortcuts' Guid='*'>

                        <Shortcut Id='StartMenuServer'
                            Name='nexrade-cache Server'
                            Description='Start nexrade-cache Redis-compatible cache server'
                            Target='[Bin]nexrade-cache.exe'
                            WorkingDirectory='APPLICATIONFOLDER'
                            Icon='ProductICO'/>

                        <Shortcut Id='StartMenuCli'
                            Name='nexrade-cli'
                            Description='nexrade-cache command-line client'
                            Target='[Bin]nexrade-cli.exe'
                            WorkingDirectory='APPLICATIONFOLDER'
                            Icon='ProductICO'/>

                        <Shortcut Id='UninstallShortcut'
                            Name='Uninstall nexrade-cache'
                            Target='[System64Folder]msiexec.exe'
                            Arguments='/x [ProductCode]'/>

                        <RemoveFolder Id='ApplicationProgramsFolder' On='uninstall'/>
                        <RegistryValue
                            Root='HKCU'
                            Key='Software\Nexrade\nexrade-cache'
                            Name='installed'
                            Type='integer'
                            Value='1'
                            KeyPath='yes'/>
                    </Component>
                </Directory>
            </Directory>

            <!-- Desktop shortcut (optional feature) -->
            <Directory Id='DesktopFolder' Name='Desktop'>
                <Component Id='DesktopShortcut' Guid='*'>
                    <Shortcut Id='DesktopServer'
                        Name='nexrade-cache'
                        Description='Start nexrade-cache Redis-compatible cache server'
                        Target='[Bin]nexrade-cache.exe'
                        WorkingDirectory='APPLICATIONFOLDER'
                        Icon='ProductICO'/>
                    <RemoveFolder Id='DesktopFolder' On='uninstall'/>
                    <RegistryValue
                        Root='HKCU'
                        Key='Software\Nexrade\nexrade-cache'
                        Name='desktop'
                        Type='integer'
                        Value='1'
                        KeyPath='yes'/>
                </Component>
            </Directory>

        </Directory>

        <!-- ── Features ──────────────────────────────────────────────── -->
        <Feature
            Id='Binaries'
            Title='nexrade-cache (required)'
            Description='Installs the nexrade-cache server and nexrade-cli client.'
            Level='1'
            ConfigurableDirectory='APPLICATIONFOLDER'
            AllowAdvertise='no'
            Display='expand'
            Absent='disallow'>

            <ComponentRef Id='binary0'/>
            <ComponentRef Id='binary1'/>
            <ComponentRef Id='ConfigExample'/>
            <ComponentRef Id='ApplicationShortcuts'/>
            <ComponentRef Id='NexradeCacheFirewall'/>

            <Feature
                Id='Environment'
                Title='Add to PATH'
                Description='Add the install location to the PATH environment variable so nexrade-cache and nexrade-cli can be run from any terminal.'
                Level='1'
                Absent='allow'>
                <ComponentRef Id='Path'/>
            </Feature>

            <Feature
                Id='Desktop'
                Title='Desktop Shortcut'
                Description='Add a nexrade-cache shortcut to the Desktop.'
                Level='1'
                Absent='allow'>
                <ComponentRef Id='DesktopShortcut'/>
            </Feature>

            <Feature
                Id='WindowsService'
                Title='Windows Service (Auto-start)'
                Description='Install nexrade-cache as a Windows Service that starts automatically on boot.'
                Level='1000'
                Absent='allow'>
                <ComponentRef Id='NexradeCacheService'/>
            </Feature>
        </Feature>

        <!-- ── Product icon ──────────────────────────────────────────── -->
        <Icon Id='ProductICO' SourceFile='nexrade-cli\wix\nexrade-cache.ico'/>
        <Property Id='ARPPRODUCTICON' Value='ProductICO'/>

        <!-- ── Add/Remove Programs metadata ─────────────────────────── -->
        <SetProperty Id='ARPINSTALLLOCATION' Value='[APPLICATIONFOLDER]' After='CostFinalize'/>
        <Property Id='ARPHELPLINK' Value='https://github.com/nexrade/nexrade-cache'/>
        <Property Id='ARPURLINFOABOUT' Value='https://github.com/nexrade/nexrade-cache'/>
        <Property Id='ARPCONTACT' Value='https://github.com/nexrade/nexrade-cache/issues'/>

        <!-- ── Installer UI ──────────────────────────────────────────── -->
        <UI>
            <!--
                Custom dialog: Redis 3-style "Port Number and Firewall
                Exception" screen, inserted between CustomizeDlg
                (feature tree) and VerifyReadyDlg. Captures the listener
                port and an opt-out firewall checkbox, both consumed by
                downstream components.
            -->
            <Dialog Id='PortFirewallDlg' Width='370' Height='270' Title='nexrade-cache Setup'>
                <!-- Geometry mirrors WixUI's own CustomizeDlg so this screen
                     does not visibly jump when the user clicks Next: banner
                     44dlu tall with a separator line beneath it, Title at
                     (15,6) and Description at (25,23) *inside* the banner,
                     body text starting at Y=55, buttons on the 243 baseline
                     with Back at X=192. An earlier 58dlu banner stretched the
                     493x58 bitmap into the wrong box and left the heading
                     misaligned against the built-in dialogs.

                     Text is the Binary row Id, not the WixVariable name:
                     WixUIBannerBmp is the variable that overrides the
                     bitmap's *source file*, while the row WixUIExtension
                     actually emits is WixUI_Bmp_Banner. Naming the variable
                     here links with LGHT0094 (unresolved Binary symbol). -->
                <Control Id='BannerBitmap' Type='Bitmap' Width='370' Height='44' X='0' Y='0'
                         TabSkip='no' Text='WixUI_Bmp_Banner'/>
                <Control Id='Title' Type='Text' X='15' Y='6' Width='210' Height='15'
                         Transparent='yes' NoPrefix='yes'
                         Text='{\WixUI_Font_Title}Port Number and Firewall Exception'/>
                <Control Id='Description' Type='Text' X='25' Y='23' Width='280' Height='15'
                         Transparent='yes' NoPrefix='yes'
                         Text='Select the listener port and firewall exception.'/>
                <Control Id='BannerLine' Type='Line' X='0' Y='44' Width='370' Height='0'/>
                <Control Id='BodyText' Type='Text' X='25' Y='55' Width='320' Height='20'
                         Text='Select whether to add an exception to the Windows Firewall for nexrade-cache.'/>
                <Control Id='PortLabel' Type='Text' X='25' Y='105' Width='220' Height='17'
                         Text='Port to run nexrade-cache on:'/>
                <Control Id='PortEdit' Type='Edit' Width='80' Height='17' X='250' Y='103'
                         Property='INSTALLPORT' Indirect='no'/>
                <Control Id='FirewallCheckBox' Type='CheckBox' Width='320' Height='17' X='25' Y='135'
                         Property='INSTALLFIREWALL' CheckBoxValue='EnableFirewall'
                         Text='Add an exception to the Windows Firewall.'/>
                <Control Id='BottomLine' Type='Line' X='0' Y='234' Width='370' Height='0'/>
                <Control Id='Back' Type='PushButton' X='192' Y='243' Width='56' Height='17'
                         Text='&amp;Back'>
                    <Publish Event='NewDialog' Value='CustomizeDlg'>1</Publish>
                </Control>
                <Control Id='Next' Type='PushButton' X='248' Y='243' Width='56' Height='17'
                         Default='yes' Text='&amp;Next'>
                    <Publish Event='NewDialog' Value='MemoryLimitDlg'>1</Publish>
                </Control>
                <Control Id='Cancel' Type='PushButton' X='304' Y='243' Width='56' Height='17'
                         Cancel='yes' Text='Cancel'>
                    <Publish Event='EndDialog' Value='Exit'>1</Publish>
                </Control>
            </Dialog>

            <!--
                Custom dialog: Redis 3-style "Memory Limit" screen, inserted
                between PortFirewallDlg and VerifyReadyDlg.

                The checkbox drives SETMAXMEMORY; the edit box collects
                MAXMEMORYMB in megabytes (the unit operators think in, and
                what the Redis installer asks for). The server's maxmemory
                flag takes *bytes*, so the value is converted before it
                reaches the service command line — MSI's formatted-string
                syntax has no arithmetic.

                Unticking the checkbox disables the edit box and leaves the
                maxmemory flag off the command line entirely, which the server
                reads as unlimited.
            -->
            <Dialog Id='MemoryLimitDlg' Width='370' Height='270' Title='nexrade-cache Setup'>
                <!-- Same geometry as PortFirewallDlg above and WixUI's
                     CustomizeDlg: 44dlu banner, separator at Y=44, heading
                     inside the banner, buttons on the 243 baseline. -->
                <Control Id='BannerBitmap' Type='Bitmap' Width='370' Height='44' X='0' Y='0'
                         TabSkip='no' Text='WixUI_Bmp_Banner'/>
                <Control Id='Title' Type='Text' X='15' Y='6' Width='210' Height='15'
                         Transparent='yes' NoPrefix='yes'
                         Text='{\WixUI_Font_Title}Memory Limit'/>
                <Control Id='Description' Type='Text' X='25' Y='23' Width='280' Height='15'
                         Transparent='yes' NoPrefix='yes'
                         Text='Select whether to use a memory limit or not.'/>
                <Control Id='BannerLine' Type='Line' X='0' Y='44' Width='370' Height='0'/>
                <Control Id='MaxMemoryCheckBox' Type='CheckBox' Width='320' Height='17' X='25' Y='70'
                         Property='SETMAXMEMORY' CheckBoxValue='1'
                         Text='Set the Max Memory limit'/>
                <Control Id='MaxMemoryLabel' Type='Text' X='25' Y='110' Width='90' Height='17'
                         Text='Max Memory:'>
                    <Condition Action='enable'><![CDATA[SETMAXMEMORY]]></Condition>
                    <Condition Action='disable'><![CDATA[NOT SETMAXMEMORY]]></Condition>
                </Control>
                <Control Id='MaxMemoryEdit' Type='Edit' Width='60' Height='17' X='120' Y='108'
                         Property='MAXMEMORYMB' Indirect='no'>
                    <Condition Action='enable'><![CDATA[SETMAXMEMORY]]></Condition>
                    <Condition Action='disable'><![CDATA[NOT SETMAXMEMORY]]></Condition>
                </Control>
                <Control Id='MaxMemoryUnit' Type='Text' X='186' Y='110' Width='40' Height='17'
                         Text='MB'>
                    <Condition Action='enable'><![CDATA[SETMAXMEMORY]]></Condition>
                    <Condition Action='disable'><![CDATA[NOT SETMAXMEMORY]]></Condition>
                </Control>
                <Control Id='BottomLine' Type='Line' X='0' Y='234' Width='370' Height='0'/>
                <Control Id='Back' Type='PushButton' X='192' Y='243' Width='56' Height='17'
                         Text='&amp;Back'>
                    <Publish Event='NewDialog' Value='PortFirewallDlg'>1</Publish>
                </Control>
                <Control Id='Next' Type='PushButton' X='248' Y='243' Width='56' Height='17'
                         Default='yes' Text='&amp;Next'>
                    <Publish Event='NewDialog' Value='VerifyReadyDlg'>1</Publish>
                </Control>
                <Control Id='Cancel' Type='PushButton' X='304' Y='243' Width='56' Height='17'
                         Cancel='yes' Text='Cancel'>
                    <Publish Event='EndDialog' Value='Exit'>1</Publish>
                </Control>
            </Dialog>

            <UIRef Id='WixUI_FeatureTree'/>
            <!-- Skip the EULA dialog (go straight to feature selection) -->
            <Publish Dialog='WelcomeDlg'  Control='Next' Event='NewDialog' Value='CustomizeDlg' Order='99'>1</Publish>
            <Publish Dialog='CustomizeDlg' Control='Back' Event='NewDialog' Value='WelcomeDlg'  Order='99'>1</Publish>
            <!-- Insert the port + firewall dialog after the feature tree.
                 Order='99' so we deterministically win over WixUI_FeatureTree's
                 built-in CustomizeDlg Next -> VerifyReadyDlg publish (which
                 ships with the implicit default Order=1). Without the explicit
                 Order, both rules match the same condition (1) and the
                 declaration-order tiebreak is not guaranteed across MSI runtime
                 versions; with Order=99 ours is evaluated last and wins. -->
            <Publish Dialog='CustomizeDlg'     Control='Next' Event='NewDialog' Value='PortFirewallDlg' Order='99'>1</Publish>
            <!-- PortFirewallDlg and MemoryLimitDlg declare their own Back/Next
                 publishes inline on their <Control> elements above, chaining
                 CustomizeDlg -> PortFirewallDlg -> MemoryLimitDlg ->
                 VerifyReadyDlg. Repeating those rules here would emit
                 duplicate ControlEvent rows (LGHT0091). -->
        </UI>

        <!-- Defaults for the dialog. INSTALLPORT: 6379 — the standard Redis
             port, matching ServerConfig::default() so the MSI install and a
             plain `nexrade-cache` run land on the same port. Note this will
             collide with an already-running Redis on the same host; the
             operator can override it in the dialog. INSTALLFIREWALL defaults
             to EnableFirewall (defined below) so the checkbox is ticked out
             of the box; unticking it leaves the firewall component
             un-installed via its <Condition>. EnableFirewall is the value the
             checkbox writes when ticked. -->
        <Property Id='INSTALLPORT' Value='6379'/>
        <Property Id='INSTALLFIREWALL' Value='EnableFirewall'/>
        <Property Id='EnableFirewall' Value='1'/>

        <!-- Memory-limit dialog defaults. SETMAXMEMORY ticked with 500 MB
             matches the Redis installer's defaults. MAXMEMORYBYTES is derived
             from MAXMEMORYMB at install time (see SetMaxMemoryBytes) and is
             what actually reaches the service command line. -->
        <Property Id='SETMAXMEMORY' Value='1'/>
        <Property Id='MAXMEMORYMB' Value='500'/>

        <!--
            MB -> bytes. The Windows Installer formatted-string syntax has no
            arithmetic, so multiplying by 1,048,576 is not expressible here.
            Appending "000000" multiplies by 1,000,000 using plain string
            concatenation, giving MB in the SI sense (500 MB -> 500000000
            bytes). That is a ~4.6% smaller limit than the binary MiB reading
            of the same number, which is the safer direction to err: the
            process caps slightly below what the operator typed rather than
            slightly above.

            Sequenced after CostFinalize so the properties set by the dialog
            are populated, and conditioned on SETMAXMEMORY so an unticked box
            leaves MAXMEMORYBYTES empty.

            The explicit <> "0" matters. Unticking the checkbox in the UI
            clears the property, so a bare `SETMAXMEMORY` test would be enough
            there — but a silent install passing SETMAXMEMORY=0 on the command
            line leaves it *defined* with the string "0", which MSI conditions
            treat as true. Without this the limit would be applied anyway.
        -->
        <SetProperty Id='MAXMEMORYBYTES'
                     Value='[MAXMEMORYMB]000000'
                     After='CostFinalize'
                     Sequence='both'>
            <![CDATA[SETMAXMEMORY AND SETMAXMEMORY <> "0" AND MAXMEMORYMB]]>
        </SetProperty>

        <!--
            The whole " maxmemory N" flag fragment, or empty. ServiceInstall's
            Arguments is a single static string, so the flag has to be
            conditionally built here rather than conditionally appended there —
            an unticked checkbox must leave the flag off entirely, not pass an
            empty value (the flag with no argument fails to parse).

            Anchored explicitly after SetMAXMEMORYBYTES — the action name WiX
            generates for the SetProperty above ("Set" + property id). Both
            being anchored to CostFinalize is not enough: WiX assigned this one
            sequence 1002 and the conversion 1003, so this ran first and
            expanded MAXMEMORYBYTES while it was still empty, producing a bare
            flag with no value. Naming the action pins the real dependency.
        -->
        <SetProperty Id='MAXMEMORYARG'
                     Value=' --maxmemory [MAXMEMORYBYTES]'
                     After='SetMAXMEMORYBYTES'
                     Sequence='both'>
            <![CDATA[SETMAXMEMORY AND SETMAXMEMORY <> "0" AND MAXMEMORYMB]]>
        </SetProperty>

        <!-- ── Custom banner image (493×58 px) ──────────────────────── -->
        <WixVariable Id='WixUIBannerBmp' Value='nexrade-cli\wix\Banner.bmp'/>

    </Product>

</Wix>
